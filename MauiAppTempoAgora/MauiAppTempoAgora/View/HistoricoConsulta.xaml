<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTempoAgora.View.HistoricoConsulta"
             Title="Histórico">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Faça sua Consulta"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>

            <Entry Placeholder="Digite uma cidade..."
                   Text="{Binding Cidade}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#3A3A3A}"
                   FontSize="16"/>

            <!-- Data/Hora Início -->
            <Label Text="Data/Hora Início:"
                   FontSize="13"
                   FontAttributes="Bold"/>
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <DatePicker Grid.Column="0" Date="{Binding DataInicio}" />
                <TimePicker Grid.Column="1" Time="{Binding HoraInicio}" />
            </Grid>

            <!-- Data/Hora Fim -->
            <Label Text="Data/Hora Fim:"
                   FontSize="13"
                   FontAttributes="Bold"/>
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <DatePicker Grid.Column="0" Date="{Binding DataFim}" />
                <TimePicker Grid.Column="1" Time="{Binding HoraFim}" />
            </Grid>

            <!-- Botões -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="Todos"
                        Command="{Binding CarregarTodos}"
                        CornerRadius="10"
                        HeightRequest="40"
                        BackgroundColor="#28A745"
                        TextColor="White"/>
                <Button Grid.Column="1"
                        Text="Pesquisar"
                        Command="{Binding BuscarPorPeriodo}"
                        CornerRadius="10"
                        HeightRequest="40"
                        BackgroundColor="#28A745"
                        TextColor="White"/>
            </Grid>

            <CollectionView ItemsSource="{Binding ListaConsultas}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#3A3A3A}">
                            <VerticalStackLayout Spacing="4">
                                <Image Source="{Binding icon}"
                                       HeightRequest="80"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding Cidade}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding lat, StringFormat='Latitude: {0}'}" />
                                <Label Text="{Binding lon, StringFormat='Longitude: {0}'}" />
                                <Label Text="{Binding temp, StringFormat='Temperatura: {0}°C'}" />
                                <Label Text="{Binding feels_like, StringFormat='Sensação Térmica: {0}°C'}" />
                                <Label Text="{Binding temp_max, StringFormat='Temp Máx: {0}°C'}" />
                                <Label Text="{Binding temp_min, StringFormat='Temp Mín: {0}°C'}" />
                                <Label Text="{Binding sunrise, StringFormat='Nascer do Sol: {0}'}" />
                                <Label Text="{Binding sunset, StringFormat='Pôr do Sol: {0}'}" />
                                <Label Text="{Binding DataConsulta, StringFormat='Data da Consulta: {0:dd/MM/yyyy HH:mm}'}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>