<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTempoAgora.View.NovaConsulta"
             Title="Nova Consulta"
             BackgroundColor="{AppThemeBinding Light=#E3E3E3, Dark=#2D2D30}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Área de busca da cidade + botão de consulta -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry Grid.Column="0"
                       Placeholder="Digite uma cidade..."
                       Text="{Binding Cidade}"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#3A3A3A}"
                       FontSize="16"/>

                <Button Grid.Column="1"
                        Text="Pesquisar"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        Command="{Binding ConsultarTempo}" 
                        CornerRadius="10"/>
            </Grid>

            <!-- Área de resultado (só aparece quando TemDados = true) -->
            <VerticalStackLayout Spacing="12"
                                 IsVisible="{Binding TemDados}">

                <Label Text="Clima em Tempo Real"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>

                <!-- Ícone do clima vindo da API -->
                <Border BackgroundColor="{AppThemeBinding Light=#ECECEC, Dark=#404040}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15"
                        Padding="15"
                        HorizontalOptions="Center">

                    <Image Source="{Binding IconeClima}"
                           HeightRequest="80"
                           WidthRequest="80"/>
                </Border>

                <!-- Descrição completa da previsão -->
                <Label Text="{Binding Previsao}"
                       FontSize="15"
                       HorizontalTextAlignment="Start"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light=#444444, Dark=White}"/>
            </VerticalStackLayout>

            <!-- Mapa só aparece quando há dados carregados -->
            <Border IsVisible="{Binding TemDados}"
                    Stroke="#B0B0B0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3A3A3A}"
                    Padding="10">

                <WebView HeightRequest="400"
                         Source="{Binding Mapa}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>